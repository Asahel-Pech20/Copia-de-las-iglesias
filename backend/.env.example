PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://iglesia:iglesia@localhost:5432/iglesia
# Con Docker: puerto 5433. Sin Docker (PostgreSQL instalado): localhost:5432/iglesia_test. El nombre debe terminar en _test
DATABASE_URL_TEST=postgresql://iglesia:iglesia@localhost:5433/iglesia_test
JWT_ACCESS_SECRET=cambiar
JWT_REFRESH_SECRET=cambiar
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="AppIglesia <no-reply@iglesia.local>"
UPLOAD_DIR=uploads
# URL pública del backend (para construir la URL del logotipo)
API_PUBLIC_URL=http://localhost:3000
# Contraseña de los usuarios que crea el seed (uno por rol: admin@iglesia.local, pastor@…, etc.)
SEED_PASSWORD=Iglesia123
