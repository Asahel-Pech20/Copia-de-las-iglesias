{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm format*)",
      "Bash(pnpm --filter * lint*)",
      "Bash(pnpm --filter * typecheck*)",
      "Bash(pnpm --filter * test*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose config*)",
      "Bash(docker compose logs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(pnpm add*)",
      "Bash(pnpm --filter * add*)",
      "Bash(pnpm --filter * prisma migrate*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*DROP TABLE*)",
      "Bash(*DROP DATABASE*)",
      "Bash(docker compose down -v*)",
      "Bash(rm -rf*)",
      "Read(./**/.env)",
      "Edit(./**/.env)",
      "Write(./**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/formatear.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar.mjs\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
